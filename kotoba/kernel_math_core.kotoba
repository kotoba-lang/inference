(ns kernel-math-core
  (:export [dot sum-of-squares inv-rms max-element
            clamp-unit clamp-non-negative]))

;; The first slice of the inference ENGINE in Kotoba, as opposed to the
;; surface's decisions (ADR-2608138800 amendment).
;;
;; Everything here is real float arithmetic over real weight vectors, and it
;; is the half of a transformer step that is pure: a dot product, a sum of
;; squares, an RMS scale, a max for softmax stability. The host keeps the
;; bytes — GGUF mmap, dequantisation, KV cache — and hands rows in as
;; `:vector-f64`.
;;
;; ── why this line, and not further in ──
;;
;; Measured 2026-08-13 on amu e8864273 + kotoba-kir 6d08e3c, the language has
;; everything the arithmetic needs: `f64-add/sub/mul/div/min/max/sqrt`,
;; `f64-lt/gt/...`, `i64-to-f64-rounded`, `:vector-f64` parameters and
;; `vector-f64-at`/`vector-f64-count`, and tail self-recursion. A dot product
;; over host-supplied vectors returns the right answer.
;;
;; What it does NOT have is any way to READ a `:bytes` value. amu's
;; `bytes-operations` table is exactly `{bytes-empty 0}` — a constructor for
;; the empty one, and nothing else. There is no length and no byte access, so
;; a GGUF block cannot be dequantised here at all; that is the single
;; primitive standing between this file and the rest of the engine, and it is
;; `:not-yet-implemented`, not a safety constraint.
;;
;; ── this core deliberately does NOT claim native qualification ──
;;
;; `kotoba.kir/only-native-word-typed-features?` rejects f64 expressions, so
;; every export here is outside the native-word-typed walk that the ollama
;; decision cores stay inside. That is a gap in kir's admission walk rather
;; than in the language — amu ADR 0241 pins scalar f64 through machine IR on
;; x86-64 and AArch64 — but until the walk catches up, float code and
;; word-typed code cannot be in the same core without one of them losing.
;; They are separate files for that reason, and the parity test asserts the
;; split rather than letting it drift.
;;
;; Parity oracle: kotodama.inference.ops (dot-values, rms-normalize-values).
;; Test: cljc/test/kotodama/inference/kernel_math_parity_test.clj

;; ── dot product ──────────────────────────────────────────────────────
;; Tail self-recursion over an index; the host guarantees equal lengths, and
;; `dot` reads its bound from `a`, so a shorter `b` traps on the read rather
;; than silently producing a partial sum.

(defn dot-from [a :vector-f64 b :vector-f64 i :i64 n :i64 acc :f64] :f64
  (if (>= i n)
    acc
    (dot-from a b (+ i 1) n
              (f64-add acc (f64-mul (vector-f64-at a i) (vector-f64-at b i))))))

(defn dot [a :vector-f64 b :vector-f64] :f64
  (dot-from a b 0 (vector-f64-count a) 0.0))

;; ── sum of squares ───────────────────────────────────────────────────

(defn sum-sq-from [a :vector-f64 i :i64 n :i64 acc :f64] :f64
  (if (>= i n)
    acc
    (sum-sq-from a (+ i 1) n
                 (f64-add acc (f64-mul (vector-f64-at a i) (vector-f64-at a i))))))

(defn sum-of-squares [a :vector-f64] :f64
  (sum-sq-from a 0 (vector-f64-count a) 0.0))

;; ── RMS scale ────────────────────────────────────────────────────────
;; The scalar `inv-rms` of kotodama.inference.ops/rms-normalize-values:
;; 1 / sqrt(mean(x²) + eps). The elementwise multiply stays on the host,
;; where the destination buffer lives.
;;
;; An empty vector would divide by zero here. It returns 0.0 instead of a
;; NaN that would propagate silently through a whole layer — an empty row is
;; a host bug, and the host can see a 0.0 scale.

(defn inv-rms [a :vector-f64 eps :f64] :f64
  (let [n (vector-f64-count a)]
    (if (= n 0)
      0.0
      (f64-div 1.0
               (f64-sqrt (f64-add (f64-div (sum-of-squares a)
                                           (i64-to-f64-rounded n))
                                  eps))))))

;; ── max element (softmax stability) ──────────────────────────────────
;; Softmax itself is not here: it needs exp over (x - max), which reaches
;; large negative arguments, and the only exponential admitted is
;; `f64-exp-bounded` — bounded, with a domain this has not been measured
;; against. Naming the max is the part that is certainly correct today.

(defn max-from [a :vector-f64 i :i64 n :i64 acc :f64] :f64
  (if (>= i n)
    acc
    (max-from a (+ i 1) n (f64-max acc (vector-f64-at a i)))))

(defn max-element [a :vector-f64] :f64
  (let [n (vector-f64-count a)]
    (if (= n 0)
      0.0
      (max-from a 1 n (vector-f64-at a 0)))))

;; ── sampling parameter clamps ────────────────────────────────────────
;; Moved off the Ollama surface (ollama_options_core.kotoba explains why they
;; are here and not there): top_p is a probability and temperature cannot be
;; negative. Both are float, so they belong in the float core.

(defn clamp-unit [v :f64] :f64
  (f64-min (f64-max v 0.0) 1.0))

(defn clamp-non-negative [v :f64] :f64
  (f64-max v 0.0))
