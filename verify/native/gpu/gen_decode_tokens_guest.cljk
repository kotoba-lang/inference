;; Generate the :gpu/compute guest for a GREEDY decode of T tokens through the
;; first N layers of Nex-N2.5-mini, entirely on the device: the prompt token id
;; is WRITTEN once; every later token is the previous step's argmax, read by the
;; embedding kernel straight from the argmax buffer. State (conv ring, delta-net
;; S, KV cache) lives in device buffers across steps; one command buffer per token. every tensor of the layer MAPped by file offset,
;; every op of the step one DISPATCH inside a single command buffer, the layer
;; output READ back as hex. Checked by layer0_check.py against layer0_ref.py.
;;
;;   kbb --backend sci gen_decode_tokens_guest.cljk <file.gguf> <layers> <tokens> <prompt-token-id[,id...]> <dir-on-box> <out.kotoba>
;;
;; The program is straight-line: MAP/ALLOC/WRITE every constant, then ONE
;; command buffer (BEGIN .. SUBMIT) holding every dispatch of every layer and the
;; lm_head, then READ. Checked by decode_check.py against decode_ref.py.
;; Root ADR-2609182400 C.
(require '["fs" :as fs] '[clojure.string :as str])
(def args (vec *command-line-args*))
(when-not (<= 6 (count args) 9) (println "usage: <file.gguf> <layers> <tokens> <prompt-token-id[,id...]> <dir-on-box> <out.kotoba> [anv|radv|nvgpu|nvgpu-exact] [stream|flat|fn] [sample:<T>:<top_p>:<seed>]") (js/process.exit 2))
;; sample:T:top_p:seed (fn mode): nex_sample_topp replaces argmax_final -- the draw
;; u = hash(seed, pos) is reproduced by decode_tokens_ref.py --sample (iteration 18).
(def sampling (when-let [a (get args 8)] (let [[_ T tp seed] (str/split a #":")] {:T (js/parseFloat T) :top-p (js/parseFloat tp) :seed (js/parseInt seed 0)})))
;; stream: the layer weights are MAPped per layer per token and FREEd after the
;; layer's command buffer, so the whole 40-layer model runs on a device that
;; cannot hold it (K16 GTT 13 GiB vs 17.4 GB of weights) -- for parity, not
;; speed (every token re-uploads the weights). The loader hands out the lowest
;; free slot, so the generator keeps the same free list (iteration 14).
(def mode-arg (or (get args 7) "fn"))
;; "<mode>-nofuse" keeps the seven-dispatch recurrent path (gate_decay2 x2, conv1d, l2norm x2,
;; deltanet, gated_rmsnorm); the default since iteration 24 is deltanet_fused.comp, one dispatch.
(def fused? (not (str/ends-with? mode-arg "-nofuse")))
(def stream? (= "stream" (str/replace mode-arg "-nofuse" "")))
;; flat: the 2026-09-19 straight-line program (every request a literal, one copy
;; per token). Default since iteration 16 is the FUNCTION program: handles are
;; computed on the device side of the string (string-from-i64), layers and
;; tokens are recursions, the position and the token buffer live on the device.
(def flat? (= "flat" (str/replace mode-arg "-nofuse" "")))
(def fn-mode? (not (or stream? flat?)))
(def gguf (args 0)) (def layers (js/parseInt (args 1))) (def ntok (js/parseInt (args 2))) (def box (args 4)) (def out (args 5))
;; <prompt-token-id> may be a comma-separated list: the first P steps are FORCED to
;; these tokens (prefill at decode speed, one command buffer per prompt token) and
;; greedy decode continues from step P. A single-token position-0 prompt is a
;; degenerate parity probe (iteration 13): three engines gave three unrelated
;; distributions on it.
(def prompt (mapv js/parseInt (str/split (args 3) #",")))
(def tok0 (first prompt))
(when (< ntok (count prompt)) (println "REFUSE tokens" ntok "< prompt length" (count prompt)) (js/process.exit 2))
(def backend (or (get args 6) "anv"))
;; Kernel layout per (backend, tensor class) -- the co-scientist table (root
;; ADR-2609182400 C, iterations 3 and 7). Classes: :wide = the 4096/8192-row
;; projections (attn_qkv, attn_gate, attn_q, ssm_out, attn_output), :narrow =
;; 32/512-row kdots (alpha/beta, k/v, experts, shared expert), :lm = the Q6_K
;; lm_head. Measured 2026-09-19 (pinned clocks): on nvgpu r1 ~ x8 ~ r8 and the
;; shared-header kdot_s2_r1 wins every class (composed step 60.0 -> 54.0 ms), and
;; kdot_s4_r1 (all headers staged once, two blocks per iteration) 52.8 -> 48.6;
;; on RADV r8 wins attn_gate and loses the experts, and s2 LOSES (one wave64 per
;; workgroup pays the barriers); on ANV r1 wins everything but the lm_head.
(def layout-table
  {"anv"   {:wide "kdot_f32_r8.spv" :narrow "kdot_f32_r1.spv" :lm "kdot_f32_r8.spv" :expert "kdot_f32_r8.spv"}   ;; wide -> r8 (iteration 25), experts -> r8 (iteration 27: 3.30 -> 3.06 ms; narrow on r8 loses, 3.15)
   "radv"  {:wide "kdot_f32_r8.spv" :narrow "kdot_f32_r1.spv" :lm "kdot_f32_r1.spv"}
   ;; nvgpu default = packed-half dequant (kdot_h2_r1) since iteration 15: over all
   ;; 40 layers KL(oracle||h2) = 8.5e-4 nats and KL(llama.cpp||h2) = 0.0142, the same
   ;; as the exact kernel's 0.0167 -- llama.cpp itself is ~0.015 from the f64 oracle.
   ;; 12L x 3T 48.5 -> 39.3 ms/token. "nvgpu-exact" keeps the f32 path (s4).
   "nvgpu"       {:wide "kdot_h2_r1.spv" :narrow "kdot_h2_r1.spv" :lm "kdot_h2q6_r1.spv"}   ;; lm_head on the Q6_K half path (separate binary) since iteration 21
   "nvgpu-exact" {:wide "kdot_s4_r1.spv" :narrow "kdot_s4_r1.spv" :lm "kdot_s4_r1.spv"}})
(def layouts (or (layout-table backend) (do (println "REFUSE unknown backend" backend) (js/process.exit 2))))
;; --- GGUF directory (header only) ---
(def fd (fs/openSync gguf "r"))
(def head (js/Buffer.alloc (* 64 1024 1024)))
(def n (fs/readSync fd head 0 (.-length head) 0))
(def buf (.subarray head 0 n))
(def pos (atom 0))
(defn- u8 [] (let [v (.readUInt8 buf @pos)] (swap! pos + 1) v))
(defn- u32 [] (let [v (.readUInt32LE buf @pos)] (swap! pos + 4) v))
(defn- u64 [] (let [v (.readBigUInt64LE buf @pos)] (swap! pos + 8) (js/Number v)))
(defn- f32 [] (let [v (.readFloatLE buf @pos)] (swap! pos + 4) v))
(defn- gstr [] (let [k (u64) s (.toString buf "utf8" @pos (+ @pos k))] (swap! pos + k) s))
(declare read-value)
(defn- read-value [t]
  (case t 0 (u8) 1 (u8) 2 (do (swap! pos + 2) 0) 3 (do (swap! pos + 2) 0) 4 (u32) 5 (u32) 6 (f32) 7 (u8) 8 (gstr)
    9 (let [et (u32) k (u64)] (doall (repeatedly k #(read-value et))) nil) 10 (u64) 11 (u64) 12 (do (swap! pos + 8) 0)))
(swap! pos + 4) (u32) (def n-tensors (u64)) (def n-kv (u64))
(def kv (into {} (for [_ (range n-kv)] (let [k (gstr) t (u32)] [k (read-value t)]))))
(def tensors (into {} (for [_ (range n-tensors)] (let [name (gstr) nd (u32) dims (vec (repeatedly nd u64)) typ (u32) off (u64)] [name {:dims dims :type typ :offset off}]))))
(def alignment (get kv "general.alignment" 32))
(def data-start (* (quot (+ @pos alignment -1) alignment) alignment))
(def eps (get kv "qwen35moe.attention.layer_norm_rms_epsilon"))
(def block-bytes {12 144 13 176 14 210 23 136 0 nil})
(defn tensor-bytes [{:keys [dims type]}]
  (let [cols (first dims) rows (reduce * 1 (rest dims))]
    (if (= 0 type) (* rows cols 4) (* rows (quot cols 256) (block-bytes type)))))
(defn T* [full] (or (get tensors full) (do (println "REFUSE no tensor" full) (js/process.exit 2))))
(def interval (get kv "qwen35moe.full_attention_interval" 4))
(def recurrent (vec (for [il (range 64)] (if (zero? (mod (inc il) interval)) 0 1))))  ;; llama.cpp: full attention every `interval`-th layer
(def nrot (get kv "qwen35moe.rope.dimension_count")) (def rope-base (get kv "qwen35moe.rope.freq_base"))
;; --- emission helpers ---
;; The loader assigns buffer handles 1, 2, 3 ... in ALLOC/MAP order and pipeline
;; handles 1, 2, 3 ... in PIPELINE order (kexe_gpu_vulkan.c: "first free slot",
;; and nothing is FREEd here). The generator therefore KNOWS every handle at
;; generation time and writes it as a literal: no binding stays live across the
;; ~1,000 requests of a multi-token step. Measured 2026-09-19: binding every
;; handle (358 lets + the request temporaries) hit kotoba-mir's
;; :spill-frame-too-large at 4,095 slots on a 12-layer x 3-token guest; the
;; same guest with literal handles compiles.
(def lines (atom []))
(def next-buffer (atom 1))
(def free-slots (atom (sorted-set)))
(defn alloc-slot! [] (if-let [f (first @free-slots)] (do (swap! free-slots disj f) f) (let [h @next-buffer] (swap! next-buffer inc) h)))
(def next-pipeline (atom 1))
(defn le32 [v] (let [b (js/Buffer.alloc 4)] (.writeUInt32LE b (js/Number v) 0) (.toString b "hex")))
(defn lef32 [v] (let [b (js/Buffer.alloc 4)] (.writeFloatLE b v 0) (.toString b "hex")))
(defn step! [req-expr] (swap! lines conj req-expr))
(defn q [s] (str "\"" s "\""))
(defn free! [h] (step! (q (str "FREE " h))) (swap! free-slots conj (js/parseInt h)))
(defn cat [& xs] (reduce (fn [a b] (str "(string-concat " a " " b ")")) xs))
(defn map-tensor! [nm]
  (let [t (T* nm) h (alloc-slot!)] (step! (q (str "MAP " box "/nex.gguf " (+ data-start (:offset t)) " " (tensor-bytes t)))) (str h)))
(defn alloc! [bytes] (let [h (alloc-slot!)] (step! (q (str "ALLOC " bytes))) (str h)))
(defn zero! [h] (step! (q (str "ZERO " h))))
(defn write! [h hex] (step! (q (str "WRITE " h " 0 " hex))))
(defn pipeline! [spv bindings] (let [h @next-pipeline] (swap! next-pipeline inc) (step! (q (str "PIPELINE " box "/" spv " " bindings))) (str h)))
;; A handle written "$name" is a Kotoba VARIABLE of the generated program (stream
;; mode: the layer body is a function of its weight handles); anything else is a
;; literal. Consecutive literal pieces are merged into one quoted string.
(defn sym? [h] (and (string? h) (str/starts-with? h "$")))
(defn req-expr [pieces]
  (let [parts (reduce (fn [acc p] (if (sym? p) (conj acc p)
                                    (if (and (seq acc) (not (sym? (peek acc)))) (conj (pop acc) (str (peek acc) p)) (conj acc p))))
                      [] pieces)]
    (if (and (= 1 (count parts)) (not (sym? (first parts)))) (q (first parts))
        (apply cat (map #(if (sym? %) (subs % 1) (q %)) parts)))))
(defn dispatch-expr [op pipe x y z handles] (req-expr (concat [(str op " " pipe " " x " " y " " z)] (mapcat (fn [h] [" " h]) handles))))
(defn dispatch! [pipe x y z & handles] (step! (dispatch-expr "DISPATCH" pipe x y z handles)))
;; DISPATCHC = no barrier before this dispatch (amu loader, 2026-09-19): the
;; generator asserts that it reads nothing written, and writes nothing touched,
;; since the last plain DISPATCH. Measured floor per dispatch with / without the
;; barrier: B70 13 / 0.18 us, K16 2.7 / 0.15, Xavier 3.5 / 0.35 (iteration 10).
(defn dispatchc! [pipe x y z & handles] (step! (dispatch-expr "DISPATCHC" pipe x y z handles)))
(defn ops-meta! [n rows aux aux2 eps scale] (let [m (alloc! 32)] (write! m (str (le32 n) (le32 rows) (le32 aux) (le32 aux2) (lef32 eps) (lef32 scale) (lef32 0) (lef32 0))) m))
;; p1 = 1: the kernel takes the position from the pos buffer (binding 6) -- nex_ops.comp dyn_pos
(defn ops-meta-dyn! [n rows aux aux2 eps scale] (let [m (alloc! 32)] (write! m (str (le32 n) (le32 rows) (le32 aux) (le32 aux2) (lef32 eps) (lef32 scale) (lef32 0) (lef32 1))) m))
(defn kdot-meta! [rows cols type positions input-per-expert] (let [m (alloc! 32)] (write! m (str (le32 rows) (le32 cols) (le32 type) (le32 positions) (le32 input-per-expert) (le32 0) (le32 0) (le32 0))) m))
(def counter (atom 0))
(defn fresh [prefix] (swap! counter inc) (str prefix @counter))
;; --- the plan ---
(def zeros16 (alloc! 16))
(def ops (into {} (for [op ["rmsnorm" "l2norm" "gated_rmsnorm" "silu_mul" "conv1d_step" "softmax_topk" "gate_decay2" "weighted_sum" "add" "f32_matvec" "add_rmsnorm" "rope_neox" "attn_decode" "argmax_partial" "argmax_final" "copy_at" "pos_incr" "sample_part" "sample_probs" "sample_bisect_part" "sample_bisect_step" "sample_final"]] [op (pipeline! (str "nex_" op ".spv") 7)])))
(def kdot-wide (pipeline! (:wide layouts) 5))
(def kdot-narrow (pipeline! (:narrow layouts) 5))
(def kdot-lm (pipeline! (:lm layouts) 5))
(def kdot-expert (if (:expert layouts) (pipeline! (:expert layouts) 5) kdot-narrow))   ;; the three 8-position expert kdots (iteration 27)
(defn wg-of [spv rows] (if (= spv "kdot_f32_r8.spv") (quot (+ rows 7) 8) rows))
(def expert-spv (or (:expert layouts) (:narrow layouts)))
(def deltanet (pipeline! "deltanet_step.spv" 8))
(def deltanet-fused (when fused? (pipeline! "deltanet_fused.spv" 13)))
(def embed (pipeline! "embed_iq4xs.spv" 5))
(def w-embd (map-tensor! "token_embd.weight"))
(def prompt-ids (alloc! (max 16 (* 4 (count prompt)))))
(def x (alloc! 8192))
(def h (alloc! 8192)) (def qkv (alloc! 32768)) (def z (alloc! 16384)) (def alpha (alloc! 128)) (def betaL (alloc! 128)) (def gb (alloc! 256)) (def beta-only (alloc! 256))
(def conv (alloc! 32768)) (def qn (alloc! 8192)) (def kn (alloc! 8192)) (def dn (alloc! 16384)) (def gnorm (alloc! 16384)) (def attn-out (alloc! 8192))
(def qfull (alloc! 32768)) (def kproj (alloc! 2048)) (def vproj (alloc! 2048)) (def qnorm (alloc! 16384)) (def knorm (alloc! 2048)) (def qrope (alloc! 16384)) (def krope (alloc! 2048)) (def attno (alloc! 16384))
(def resid (alloc! 8192)) (def h2 (alloc! 8192)) (def router (alloc! 1024)) (def ids (alloc! 64)) (def topw (alloc! 64))
(def gateE (alloc! 16384)) (def upE (alloc! 16384)) (def actE (alloc! 16384)) (def downE (alloc! 65536))
(def sg (alloc! 2048)) (def su (alloc! 2048)) (def sact (alloc! 2048)) (def shdown (alloc! 8192)) (def shlogit (alloc! 16)) (def ffn (alloc! 8192))
(def xa (alloc! 8192)) (def xb (alloc! 8192))
(zero! zeros16)
(write! prompt-ids (apply str (map le32 prompt)))
(def rings (vec (for [il (range layers) :when (= 1 (recurrent il))] (let [r (alloc! (if fused? 196608 98304))] (zero! r) r))))   ;; fused: 2 slots x 3 x 8192 (double-buffered by pos parity)
(def states (vec (for [il (range layers) :when (= 1 (recurrent il))] (let [s (alloc! 2097152)] (zero! s) s))))
(def kcaches (vec (for [il (range layers) :when (= 0 (recurrent il))] (let [b (alloc! (* ntok 2048))] (zero! b) b))))
(def vcaches (vec (for [il (range layers) :when (= 0 (recurrent il))] (let [b (alloc! (* ntok 2048))] (zero! b) b))))
(def m-norm (ops-meta! 2048 1 0 0 eps 0)) (def m-qkv (kdot-meta! 8192 2048 13 1 0)) (def m-gate (kdot-meta! 4096 2048 23 1 0))
(def m-ab (kdot-meta! 32 2048 23 1 0)) (def m-gd (ops-meta! 32 32 32 0 0 0)) (def m-gd0 (ops-meta! 32 32 0 0 0 0)) (def m-conv (ops-meta! 8192 1 0 0 0 0))
(def m-l2q (ops-meta! 128 16 0 0 eps (/ 1.0 (js/Math.sqrt 128)))) (def m-l2k (ops-meta! 128 16 0 2048 eps 0))
(def m-dn (let [m (alloc! 32)] (write! m (str (le32 32) (le32 128) (le32 128) (le32 16) (le32 4096) (le32 0) (le32 0) (le32 0))) m))
(def m-fused (when fused? (let [m (alloc! 32)] (write! m (str (le32 32) (le32 128) (le32 128) (le32 16) (le32 4096) (le32 8192) (lef32 eps) (lef32 (/ 1.0 (js/Math.sqrt 128))))) m)))
(def m-gn (ops-meta! 128 32 0 0 eps 0)) (def m-out (kdot-meta! 2048 4096 23 1 0))
(def m-q (kdot-meta! 8192 2048 23 1 0)) (def m-k (kdot-meta! 512 2048 23 1 0)) (def m-v (kdot-meta! 512 2048 13 1 0))
(def m-qnorm (ops-meta! 256 16 512 0 eps 0)) (def m-knorm (ops-meta! 256 2 0 0 eps 0))
(def m-attn-o (kdot-meta! 2048 4096 23 1 0))
(def m-addn (ops-meta! 2048 1 0 0 eps 0)) (def m-router (ops-meta! 2048 256 0 0 0 0)) (def m-topk (ops-meta! 256 1 8 0 0 1.0))
(def m-gate-exps (kdot-meta! 512 2048 23 8 0)) (def m-down-exps (kdot-meta! 2048 512 23 8 1))
(def m-silu8 (ops-meta! 4096 1 0 0 0 0)) (def m-gate-sh (kdot-meta! 512 2048 23 1 0)) (def m-down-sh (kdot-meta! 2048 512 23 1 0))
(def m-silu-sh (ops-meta! 512 1 0 0 0 0)) (def m-shlogit (ops-meta! 2048 1 0 0 0 0)) (def m-wsum (ops-meta! 2048 1 8 0 0 0)) (def m-add (ops-meta! 2048 1 0 0 0 0))
(def w-out-norm (map-tensor! "output_norm.weight")) (def w-lm (map-tensor! "output.weight"))
(def hN (alloc! 8192)) (def logits (alloc! (* 248320 4))) (def amax-s (alloc! 256)) (def amax-ids (alloc! 256))
(def m-lm (kdot-meta! 248320 2048 14 1 0)) (def m-am1 (ops-meta! 248320 1 61 0 0 0)) (def m-am2 (ops-meta! 248320 1 61 0 0 0))
;; per-token metas: rope position, attention T, cache row, embedding source slot
(def m-embedP (vec (for [p (range (count prompt))] (let [m (alloc! 16)] (write! m (str (le32 2048) (le32 p) (le32 0) (le32 0))) m))))   ;; slot p of prompt-ids (forced token)
(def m-embed1 (let [m (alloc! 16)] (write! m (str (le32 2048) (le32 61) (le32 0) (le32 0))) m))    ;; slot 61 of amax-ids = the argmax
(def m-ropeq (vec (for [pos (range ntok)] (ops-meta! 256 16 nrot pos 0 rope-base))))
(def m-ropek (vec (for [pos (range ntok)] (ops-meta! 256 2 nrot pos 0 rope-base))))
(def m-attn (vec (for [pos (range ntok)] (ops-meta! 256 16 (inc pos) 2 -1.0 (/ 1.0 16.0)))))
(def m-copy (vec (for [pos (range ntok)] (ops-meta! 512 1 0 (* pos 512) 0 0))))
;; stream mode: one meta per kind, position read from posbuf on the device
(def posbuf (alloc! 16))
(def m-ropeq-dyn (ops-meta-dyn! 256 16 nrot 0 0 rope-base)) (def m-ropek-dyn (ops-meta-dyn! 256 2 nrot 0 0 rope-base))
(def m-attn-dyn (ops-meta-dyn! 256 16 0 2 -1.0 (/ 1.0 16.0))) (def m-copy-dyn (ops-meta-dyn! 512 1 0 512 0 0))
;; fn mode: the token buffer holds the prompt, then argmax_final appends each next token; embed reads slot pos
(def tokbuf (let [b (alloc! (max 16 (* 4 (+ ntok 1))))] (write! b (apply str (map le32 prompt))) b))
(def m-embed-dyn (let [m (alloc! 16)] (write! m (str (le32 2048) (le32 0) (le32 1) (le32 0))) m))
(def m-am2-dyn (let [m (alloc! 32)] (write! m (str (le32 248320) (le32 1) (le32 61) (le32 (count prompt)) (lef32 0) (lef32 0) (lef32 0) (lef32 1))) m))
(def m-incr (ops-meta! 1 1 0 0 0 0))
;; sampler meta: n rows aux(=ids slot 61) aux2(=prompt length) eps(=T) scale(=top_p) p0(=seed bits) p1(=1)
(def m-sample (when sampling (let [m (alloc! 32)] (write! m (str (le32 248320) (le32 1) (le32 61) (le32 (count prompt)) (lef32 (:T sampling)) (lef32 (:top-p sampling)) (le32 (:seed sampling)) (lef32 1))) m)))
(def sample-o (when sampling (alloc! 1024)))          ;; partial max / Z / mass, lo / hi
(def sample-s (when sampling (alloc! (* 248320 4))))  ;; p_i
(def rec-keys [:norm :post :router :shgate-inp :gate-exps :up-exps :down-exps :gate-sh :up-sh :down-sh :qkv :gate :alpha :beta :dt :a :conv :ssm-norm :out])
(def att-keys [:norm :post :router :shgate-inp :gate-exps :up-exps :down-exps :gate-sh :up-sh :down-sh :q :k :v :qn :kn :o])
(def tensor-name {:norm "attn_norm.weight" :post "post_attention_norm.weight" :router "ffn_gate_inp.weight" :shgate-inp "ffn_gate_inp_shexp.weight"
                  :gate-exps "ffn_gate_exps.weight" :up-exps "ffn_up_exps.weight" :down-exps "ffn_down_exps.weight" :gate-sh "ffn_gate_shexp.weight" :up-sh "ffn_up_shexp.weight" :down-sh "ffn_down_shexp.weight"
                  :qkv "attn_qkv.weight" :gate "attn_gate.weight" :alpha "ssm_alpha.weight" :beta "ssm_beta.weight" :dt "ssm_dt.bias" :a "ssm_a" :conv "ssm_conv1d.weight" :ssm-norm "ssm_norm.weight" :out "ssm_out.weight"
                  :q "attn_q.weight" :k "attn_k.weight" :v "attn_v.weight" :qn "attn_q_norm.weight" :kn "attn_k_norm.weight" :o "attn_output.weight"})
(defn layer-weights! [il]
  ;; MAP in rec-keys / att-keys order -- a map LITERAL with more than 8 entries is
  ;; evaluated in hash order under nbb (the MAP lines came out scrambled, iteration
  ;; 16), and fn mode addresses handle(il, k) = W0 + 19 il + index(k).
  (let [p (str "blk." il ".") rec? (= 1 (recurrent il)) keys (if rec? rec-keys att-keys)
        w (into {} (mapv (fn [k] [k (map-tensor! (str p (tensor-name k)))]) keys))]
    (when (and fn-mode? (not rec?)) (dotimes [_ 3] (alloc! 16)))   ;; pad to 19 handles per layer
    w))
(def layer-w (if stream? nil (vec (for [il (range layers)] (layer-weights! il)))))
;; --- T tokens, one command buffer each; the answer is per-token "ns|x hex|argmax hex" joined by "#" ---
(def token-answers (atom []))
(def ans-binds (atom []))

;; one layer's dispatches, for any handle representation (literal or "$symbol")
(defn emit-layer! [il w xin xout ring S kc vc mrq mrk mattn mcopy pb]
        (dispatch! (ops "rmsnorm") 1 1 1 m-norm xin (:norm w) zeros16 h zeros16 zeros16)
        (if (= 1 (recurrent il))
          (do
            (dispatch! kdot-wide (wg-of (:wide layouts) 8192) 1 1 m-qkv (:qkv w) h qkv zeros16)
            (dispatchc! kdot-wide (wg-of (:wide layouts) 4096) 1 1 m-gate (:gate w) h z zeros16)
            (dispatchc! kdot-narrow (wg-of (:narrow layouts) 32) 1 1 m-ab (:alpha w) h alpha zeros16)
            (dispatchc! kdot-narrow (wg-of (:narrow layouts) 32) 1 1 m-ab (:beta w) h betaL zeros16)
            (if fused?
              (dispatch! deltanet-fused 32 1 1 m-fused qkv (:conv w) ring alpha betaL (:dt w) (:a w) S (:ssm-norm w) z gnorm pb)
              (do
                (dispatch! (ops "gate_decay2") 1 1 1 m-gd alpha (:dt w) (:a w) gb betaL zeros16)
                (dispatchc! (ops "gate_decay2") 1 1 1 m-gd0 alpha (:dt w) (:a w) beta-only betaL zeros16)
                (dispatchc! (ops "conv1d_step") 32 1 1 m-conv qkv (:conv w) zeros16 conv ring zeros16)
                (dispatch! (ops "l2norm") 16 1 1 m-l2q conv zeros16 zeros16 qn zeros16 zeros16)
                (dispatchc! (ops "l2norm") 16 1 1 m-l2k conv zeros16 zeros16 kn zeros16 zeros16)
                (dispatch! deltanet 32 1 1 m-dn qn kn conv gb beta-only S dn)
                (dispatch! (ops "gated_rmsnorm") 32 1 1 m-gn dn (:ssm-norm w) z gnorm zeros16 zeros16)))
            (dispatch! kdot-wide (wg-of (:wide layouts) 2048) 1 1 m-out (:out w) gnorm attn-out zeros16))
          (do
            (dispatch! kdot-wide (wg-of (:wide layouts) 8192) 1 1 m-q (:q w) h qfull zeros16)
            (dispatchc! kdot-narrow (wg-of (:narrow layouts) 512) 1 1 m-k (:k w) h kproj zeros16)
            (dispatchc! kdot-narrow (wg-of (:narrow layouts) 512) 1 1 m-v (:v w) h vproj zeros16)
            (dispatch! (ops "rmsnorm") 16 1 1 m-qnorm qfull (:qn w) zeros16 qnorm zeros16 zeros16)
            (dispatchc! (ops "rmsnorm") 2 1 1 m-knorm kproj (:kn w) zeros16 knorm zeros16 zeros16)
            (dispatch! (ops "rope_neox") 16 1 1 mrq qnorm zeros16 zeros16 qrope zeros16 pb)
            (dispatchc! (ops "rope_neox") 2 1 1 mrk knorm zeros16 zeros16 krope zeros16 pb)
            (dispatchc! (ops "copy_at") 2 1 1 mcopy vproj zeros16 zeros16 vc zeros16 pb)
            (dispatch! (ops "copy_at") 2 1 1 mcopy krope zeros16 zeros16 kc zeros16 pb)
            (dispatch! (ops "attn_decode") 16 1 1 mattn qrope kc vc attno qfull pb)
            (dispatch! kdot-wide (wg-of (:wide layouts) 2048) 1 1 m-attn-o (:o w) attno attn-out zeros16)))
        (dispatch! (ops "add_rmsnorm") 1 1 1 m-addn xin attn-out (:post w) resid h2 zeros16)
        ;; barrier groups (DISPATCHC = independent of everything since the last DISPATCH)
        (dispatch! (ops "f32_matvec") 256 1 1 m-router (:router w) h2 zeros16 router zeros16 zeros16)
        (dispatchc! kdot-narrow (wg-of (:narrow layouts) 512) 1 1 m-gate-sh (:gate-sh w) h2 sg zeros16)
        (dispatchc! kdot-narrow (wg-of (:narrow layouts) 512) 1 1 m-gate-sh (:up-sh w) h2 su zeros16)
        (dispatchc! (ops "f32_matvec") 1 1 1 m-shlogit (:shgate-inp w) h2 zeros16 shlogit zeros16 zeros16)
        (dispatch! (ops "softmax_topk") 1 1 1 m-topk router zeros16 zeros16 topw zeros16 ids)
        (dispatchc! (ops "silu_mul") 2 1 1 m-silu-sh sg su zeros16 sact zeros16 zeros16)
        (dispatch! kdot-expert (wg-of expert-spv 512) 8 1 m-gate-exps (:gate-exps w) h2 gateE ids)
        (dispatchc! kdot-expert (wg-of expert-spv 512) 8 1 m-gate-exps (:up-exps w) h2 upE ids)
        (dispatchc! kdot-narrow (wg-of (:narrow layouts) 2048) 1 1 m-down-sh (:down-sh w) sact shdown zeros16)
        (dispatch! (ops "silu_mul") 16 1 1 m-silu8 gateE upE zeros16 actE zeros16 zeros16)
        (dispatch! kdot-expert (wg-of expert-spv 2048) 8 1 m-down-exps (:down-exps w) actE downE ids)
        (dispatch! (ops "weighted_sum") 8 1 1 m-wsum downE topw shdown ffn shlogit zeros16)
        (dispatch! (ops "add") 8 1 1 m-add resid ffn zeros16 xout zeros16 zeros16))

;; the token's tail: final norm, lm_head, argmax, SUBMIT (bound) and the read-backs
(defn emit-lm-head! [pos]
  (let [x-final (if (odd? (dec layers)) xb xa)]
    (dispatch! (ops "rmsnorm") 1 1 1 m-norm x-final w-out-norm zeros16 hN zeros16 zeros16)
    (dispatch! kdot-lm (wg-of (:lm layouts) 248320) 1 1 m-lm w-lm hN logits zeros16)
    (dispatch! (ops "argmax_partial") 61 1 1 m-am1 logits zeros16 zeros16 zeros16 amax-s amax-ids)
    (dispatch! (ops "argmax_final") 1 1 1 m-am2 amax-s zeros16 zeros16 amax-s amax-s amax-ids)
    ;; SUBMIT and the read-backs are bound so their answers survive to the end
    (let [ns (fresh "ns") xr (fresh "xr") idr (fresh "idr") lg (fresh "lg") last? (= pos (dec ntok))]
      (swap! ans-binds conj (cond-> [[ns (q "SUBMIT")] [xr (q (str "READ " x-final " 0 8192"))] [idr (q (str "READ " amax-ids " 244 4"))]]
                              (and stream? last?) (conj [lg (q (str "READ " logits " 0 " (* 248320 4)))])))
      (swap! token-answers conj (if (and stream? last?) (cat ns (q "|") xr (q "|") idr (q "|") lg) (cat ns (q "|") xr (q "|") idr))))))
(when flat?
  (doseq [pos (range ntok)]
    (write! posbuf (le32 pos))   ;; the fused delta-net step reads the position's parity for its conv ring slot
    (step! (q "BEGIN"))
    (dispatch! embed 1 1 1 (if (< pos (count prompt)) (m-embedP pos) m-embed1) w-embd (if (< pos (count prompt)) prompt-ids amax-ids) x zeros16)
    (let [rec-index (atom 0) att-index (atom 0)]
      (doseq [il (range layers)]
        (let [w (layer-w il) xin (if (zero? il) x (if (odd? il) xa xb)) xout (if (odd? il) xb xa)
              rec? (= 1 (recurrent il))
              ring (when rec? (rings @rec-index)) S (when rec? (states @rec-index))
              kc (when-not rec? (kcaches @att-index)) vc (when-not rec? (vcaches @att-index))]
          (if rec? (swap! rec-index inc) (swap! att-index inc))
          (emit-layer! il w xin xout ring S kc vc (m-ropeq pos) (m-ropek pos) (m-attn pos) (m-copy pos) posbuf))))
    (emit-lm-head! pos)))

;; --- stream mode: the program is FUNCTIONS (the ABI allows 5 parameters, the
;; module 64 KiB of string literals -- kotoba-sema max-parameters,
;; kotoba.kir.value/string-value-byte-limit -- so a straight-line 40-layer x
;; 5-token program (589 KB) is out). Weight handles are LITERAL even though the
;; layers MAP/FREE per token: the loader hands out the lowest free slot, so
;; every recurrent layer gets the same 19 slots and every attention layer the
;; lowest 16 of them. The position is read on the device (posbuf, nex_ops
;; dyn_pos), so a layer's dispatches are identical every token; the two layer
;; bodies take only (xin xout ring S) / (xin xout kc vc), and each layer
;; function takes the MAP prefix.
(def const-lines-snapshot (vec (take-while #(not= % (q "BEGIN")) @lines)))
;; the slot sets: simulate one recurrent and one attention layer's MAP/FREE on the free list as it stands after the constant phase
(defn simulate-slots! [keys] (let [hs (mapv (fn [_] (str (alloc-slot!))) keys)] (doseq [h hs] (swap! free-slots conj (js/parseInt h))) (zipmap keys hs)))
(def rec-slots (when stream? (simulate-slots! rec-keys)))
(def att-slots (when stream? (simulate-slots! att-keys)))
(defn body-fn-src [fname keys slots rec?]
  (reset! lines [])
  (emit-layer! (if rec? 0 3) slots "$xin" "$xout" (when rec? "$ring") (when rec? "$S") (when-not rec? "$kc") (when-not rec? "$vc") m-ropeq-dyn m-ropek-dyn m-attn-dyn m-copy-dyn posbuf)
  (let [params (concat ["xin" "xout"] (if rec? ["ring" "S"] ["kc" "vc"])) body @lines]
    (str "(defn " fname " [" (str/join " " (map #(str % " :string") params)) "] :string\n"
         "  (do\n    (gpu \"BEGIN\")\n" (str/join "\n" (map #(str "    (gpu " % ")") body)) "\n    (gpu \"SUBMIT\")))\n")))
(def rec-body-src (when stream? (body-fn-src "recurrent-layer" rec-keys rec-slots true)))
(def att-body-src (when stream? (body-fn-src "attention-layer" att-keys att-slots false)))
(defn layer-fn-src [il]
  (let [rec? (= 1 (recurrent il)) keys (if rec? rec-keys att-keys) slots (if rec? rec-slots att-slots) p (str "blk." il ".")
        rec-i (count (filter #(= 1 (recurrent %)) (range il))) att-i (count (filter #(= 0 (recurrent %)) (range il)))
        xin (if (zero? il) x (if (odd? il) xa xb)) xout (if (odd? il) xb xa)
        state-args (if rec? [(rings rec-i) (states rec-i)] [(kcaches att-i) (vcaches att-i)])]
    (str "(defn layer-" il " [g :string] :string\n  (do\n"
         (str/join "\n" (map (fn [k] (let [t (T* (str p (tensor-name k)))] (str "    (gpu (string-concat g \" " (+ data-start (:offset t)) " " (tensor-bytes t) "\"))"))) keys)) "\n"
         "    (" (if rec? "recurrent-layer" "attention-layer") " \"" xin "\" \"" xout "\" \"" (first state-args) "\" \"" (second state-args) "\")\n"
         (str/join "\n" (map #(str "    (gpu \"FREE " (slots %) "\")") (reverse keys))) "))\n")))
(def layer-fns-src (when stream? (apply str (map layer-fn-src (range layers)))))
(when stream?
  (reset! lines [])
  (doseq [pos (range ntok)]
    (write! posbuf (le32 pos))
    (step! (q "BEGIN"))
    (dispatch! embed 1 1 1 (if (< pos (count prompt)) (m-embedP pos) m-embed1) w-embd (if (< pos (count prompt)) prompt-ids amax-ids) x zeros16)
    (step! (q "SUBMIT"))
    (doseq [il (range layers)] (step! (str "(layer-" il " \"MAP " box "/nex.gguf\")")))
    (step! (q "BEGIN"))
    (emit-lm-head! pos)))

;; --- fn mode (default): computed handles, layer recursion, token recursion ---
(def W0 (when fn-mode? (js/parseInt (:norm (layer-w 0)))))
(def R0 (when fn-mode? (if (seq rings) (js/parseInt (first rings)) 0))) (def S0 (when fn-mode? (if (seq states) (js/parseInt (first states)) 0)))
(def K0 (when fn-mode? (if (seq kcaches) (js/parseInt (first kcaches)) 0))) (def V0 (when fn-mode? (if (seq vcaches) (js/parseInt (first vcaches)) 0)))
(defn hexpr [e] (str "$(string-from-i64 " e ")"))
(defn fn-body-src [fname keys rec?]
  (reset! lines [])
  (let [w (into {} (map-indexed (fn [i k] [k (hexpr (str "(+ w0 " i ")"))]) keys))]
    (emit-layer! (if rec? 0 3) w (hexpr "xin") (hexpr "xout") (when rec? (hexpr "ring")) (when rec? (hexpr "S")) (when-not rec? (hexpr "kc")) (when-not rec? (hexpr "vc")) m-ropeq-dyn m-ropek-dyn m-attn-dyn m-copy-dyn posbuf))
  (let [params (concat ["w0" "xin" "xout"] (if rec? ["ring" "S"] ["kc" "vc"])) body @lines]
    (str "(defn " fname " [" (str/join " " (map #(str % " :i64") params)) "] :string\n"
         "  (do\n" (str/join "\n" (map #(str "    (gpu " % ")") body)) "))\n")))
(def fn-rec-src (when fn-mode? (fn-body-src "recurrent-layer" rec-keys true)))
(def fn-att-src (when fn-mode? (fn-body-src "attention-layer" att-keys false)))
(def fn-layers-src (when fn-mode? (str
  ";; layer il: attention when (il + 1) mod 4 = 0; xin/xout alternate x, xa, xb; state index = il - il/4 (recurrent) or il/4 (attention)\n"
  "(defn xin-of [il :i64] :i64 (if (= il 0) " x " (if (= 1 (bit-and il 1)) " xa " " xb ")))\n"
  "(defn xout-of [il :i64] :i64 (if (= 1 (bit-and il 1)) " xb " " xa "))\n"
  "(defn layers [il :i64 n :i64] :i64\n"
  "  (if (< il n)\n"
  "    (do (if (= 3 (bit-and il 3))\n"
  "          (attention-layer (+ " W0 " (* il 19)) (xin-of il) (xout-of il) (+ " K0 " (quot il 4)) (+ " V0 " (quot il 4)))\n"
  "          (recurrent-layer (+ " W0 " (* il 19)) (xin-of il) (xout-of il) (+ " R0 " (- il (quot il 4))) (+ " S0 " (- il (quot il 4)))))\n"
  "        (layers (+ il 1) n))\n"
  "    il))\n")))
(def fn-token-src (when fn-mode?
  (reset! lines [])
  (let [x-final (if (odd? (dec layers)) xb xa)]
    (step! (q "BEGIN"))
    (dispatch! embed 1 1 1 m-embed-dyn w-embd tokbuf x posbuf)
    (step! (str "(layers 0 " layers ")"))
    (dispatch! (ops "rmsnorm") 1 1 1 m-norm x-final w-out-norm zeros16 hN zeros16 zeros16)
    (dispatch! kdot-lm (wg-of (:lm layouts) 248320) 1 1 m-lm w-lm hN logits zeros16)
    (if sampling
      ;; multi-workgroup sampler (iteration 19): 61-workgroup passes, 30 bisection rounds on tau, one final pass
      (let [h [m-sample logits tokbuf posbuf sample-o sample-s amax-ids]]
        (apply dispatch! (ops "sample_part") 61 1 1 h)
        (apply dispatch! (ops "sample_probs") 61 1 1 h)
        (dotimes [_ 30] (apply dispatch! (ops "sample_bisect_part") 61 1 1 h) (apply dispatch! (ops "sample_bisect_step") 1 1 1 h))
        (apply dispatch! (ops "sample_final") 1 1 1 h))
      (do (dispatch! (ops "argmax_partial") 61 1 1 m-am1 logits zeros16 zeros16 zeros16 amax-s amax-ids)
          (dispatch! (ops "argmax_final") 1 1 1 m-am2-dyn amax-s tokbuf posbuf amax-s amax-s amax-ids)))
    (dispatch! (ops "pos_incr") 1 1 1 m-incr zeros16 zeros16 zeros16 zeros16 zeros16 posbuf)
    (str ";; one token: embed(tokbuf[pos]) -> layers -> lm_head -> argmax (appends tokbuf[pos+1]) -> pos+1; answers accumulate as ns|x|id joined by #\n"
         "(defn token-step [pos :i64 n :i64 acc :string] :string\n"
         "  (if (< pos n)\n    (do\n"
         (str/join "\n" (map #(if (str/starts-with? % "(layers") (str "      " %) (str "      (gpu " % ")")) @lines)) "\n"
         "      (let [ns (gpu \"SUBMIT\")\n            xr (gpu \"READ " x-final " 0 8192\")\n            idr (gpu \"READ " amax-ids " 244 4\")]\n"
         "        (token-step (+ pos 1) n (string-concat acc (string-concat (if (= pos 0) \"\" \"#\") (string-concat ns (string-concat \"|\" (string-concat xr (string-concat \"|\" idr)))))))))\n"
         "    acc))\n"))))
;; --- emit: the constant phase is one let; each token's SUBMIT/READs are nested lets ---
(def const-steps (if flat? (vec (take-while #(not= % (q "BEGIN")) @lines)) const-lines-snapshot))
(def token-steps (cond flat? (vec (drop (count const-steps) @lines)) stream? (vec @lines) :else []))
;; token-steps holds every BEGIN..last dispatch in order; SUBMIT/READ are in ans-binds, one triple per token.
(defn emit-tokens [steps binds answers]
  ;; every token records the same number of lines (BEGIN + its dispatches), so
  ;; the groups are equal partitions; each token's SUBMIT/READ triple is a
  ;; nested let so the answers survive to the final string.
  (let [per (quot (count steps) ntok)
        groups (vec (partition per steps))
        body (apply str (map-indexed (fn [i g]
                                       (str (str/join "\n" (map #(if (str/starts-with? % "(layer-") (str "      " %) (str "      (gpu " % ")")) g)) "\n"
                                            "      (let [" (str/join "\n            " (map (fn [[nm req]] (str nm " (gpu " req ")")) (binds i))) "]\n"))
                                     groups))]
    (str body "        " (apply cat (interpose (q "#") answers)) (apply str (repeat (count groups) ")")))))
(def src (str ";; GENERATED by verify/native/gpu/gen_decode_tokens_guest.cljk -- do not edit.\n"
              ";; Greedy decode of " ntok " tokens from prompt tokens " (str/join "," prompt) " (forced) through layers 0.." (dec layers) " + lm_head, entirely on :gpu/compute: "
              (count @lines) " requests, one command buffer per token, state carried in device buffers. Handles are literal (sequential per kind).\n"
              ";; Answer: per token \"<ns>|<hex x after the last layer>|<hex argmax id>\", tokens joined by \"#\".\n"
              "(ns gpu.decode-tokens (:export [main]))\n"
              "(defn gpu [r :string] :string\n  (typed-cap-call :gpu/compute :string :string r))\n"
              (when stream? (str rec-body-src att-body-src layer-fns-src))
              (when fn-mode? (str fn-rec-src fn-att-src fn-layers-src fn-token-src))
              "(defn main [] :string\n"
              "    (do\n" (str/join "\n" (map #(str "      (gpu " % ")") const-steps)) "\n"
              (if fn-mode? (str "      (string-concat (token-step 0 " ntok " \"\") (string-concat \"|\" (gpu \"READ " logits " 0 " (* 248320 4) "\")))") (emit-tokens token-steps @ans-binds @token-answers)) "))\n"))
(fs/writeFileSync out src)
(println (str "wrote " out ": " (if fn-mode? (str (count const-steps) " constant requests + a token-step function") (str (count @lines) " requests")) ", layers " layers " tokens " ntok " buffers " (dec @next-buffer) " pipelines " (dec @next-pipeline) " backend " backend " layouts " (pr-str layouts) (when stream? " STREAM (per-layer MAP/FREE; last token answers its full logits)")))
