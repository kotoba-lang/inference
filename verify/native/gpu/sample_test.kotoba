;; Device-side sampling test (iteration 18): 256 draws of nex_sample_topp from ONE
;; fixed logits vector (the f64 oracle's last-step logits, dumped as f32), the
;; position counter advanced by pos_incr between draws so u = hash(seed, pos)
;; changes and the picks land in tok[1..256]. Temperature 0.8, top-p 0.95, seed
;; 0x1234567 (p0 bits). Answer: hex of tok[1..256]. Checked by sample_check.py.
(ns gpu.sample-test (:export [main]))
(defn gpu [r :string] :string
  (typed-cap-call :gpu/compute :string :string r))
(defn draws [i :i64 req :string] :i64
  (if (< i 1) 0 (do (gpu req) (gpu "DISPATCH 2 1 1 1 3 1 1 1 1 1 5") (draws (- i 1) req))))
(defn main [] :string
  (do
    (gpu "ALLOC 16")                                   ;; 1 zeros
    (gpu "MAP /root/kgpu/logits_last.f32 0 993280")    ;; 2 logits
    (gpu "ALLOC 32")                                   ;; 3 meta (incr)
    (gpu "ALLOC 32")                                   ;; 4 meta (sample)
    (gpu "ALLOC 16")                                   ;; 5 posbuf
    (gpu "ALLOC 1040")                                 ;; 6 tok (260 slots)
    (gpu "ALLOC 256")                                  ;; 7 ids
    (gpu "ALLOC 16")                                   ;; 8 scratch s
    (gpu "PIPELINE /root/kgpu/nex_sample_topp.spv 7")  ;; pipeline 1
    (gpu "PIPELINE /root/kgpu/nex_pos_incr.spv 7")     ;; pipeline 2
    (gpu "ZERO 1") (gpu "ZERO 5") (gpu "ZERO 6")
    ;; n=248320 rows=0 aux=61 aux2=0 eps=0.8 scale=0.95 p0=seed(0x01234567) p1=1.0
    (gpu "WRITE 4 0 00ca0300000000003d00000000000000cdcc4c3f3333733f674523010000803f")
    (gpu "BEGIN")
    (draws 256 "DISPATCH 1 1 1 1 4 2 6 5 1 8 7")
    (let [ns (gpu "SUBMIT")]
      (string-concat ns (string-concat "|" (gpu "READ 6 4 1024"))))))
