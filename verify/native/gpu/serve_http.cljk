;; The serving shell (iteration 42, C-3-2): an OpenAI-compatible POST /v1/completions in front of a
;; runtime-prompt kexe. text -> tokenizer_core (encode) -> kexe-loader-gpu with NEX_PROMPT and the two
;; i64 arguments (prompt length, max_tokens) -> the answer's per-step argmax ids -> decode -> JSON.
;; One process per request (the guest MAPs the weights each time); the resident form is the next step.
;; Greedy only (the guest's sampling row is a build-time choice for now).
;;
;;   NEX_GGUF=<gguf or head dump> node /opt/kbb-engine/cli.js serve_http.cljk <kexe-loader> <serve.bin> <offset> <x86_64|aarch64> <port> [allow-csv]
;;   curl -s localhost:8099/v1/completions -H 'Content-Type: application/json' -d '{"prompt":"The capital of France is","max_tokens":8}'
(require '["http" :as http] '["child_process" :as cp] '["path" :as path] '[clojure.string :as str])
(def args (vec *command-line-args*))
(when (< (count args) 5) (println "usage: <kexe-loader> <serve.bin> <offset> <isa> <port> [allow-csv]") (js/process.exit 2))
(def loader (args 0)) (def bin (args 1)) (def offset (args 2)) (def isa (args 3)) (def port (args 4))
(def allow (or (get args 5) "42,33"))
(require '[nbb.core :refer [load-file]])
(load-file (path/join (path/dirname *file*) "tokenizer_core.cljk"))
(defn run-guest [ids max-tokens]
  (let [env (js/Object.assign #js {} js/process.env #js {:NEX_PROMPT (str/join "," ids) :KEXE_RESULT_TYPE "string" :KEXE_STRUCTURED_REPORT "1"
                                                          :KEXE_FUEL "100000000" :KEXE_WALL_SECONDS "600" :KEXE_STRING_POOL "16777216" :KEXE_PAIRS "4194304"})
        t0 (js/Date.now)
        r (cp/spawnSync loader (clj->js [bin offset "2" isa allow (str (count ids)) (str max-tokens)]) (clj->js {:encoding "utf8" :env env :maxBuffer (* 64 1024 1024)}))
        out (str (.-stdout r) (.-stderr r))
        m (re-find #":result-utf8-hex \"([0-9a-f]+)\"" out)]
    (if-not m
      {:error (subs out 0 (min 400 (count out)))}
      (let [answer (.toString (js/Buffer.from (second m) "hex") "utf8")
            parts (str/split (first (str/split answer #"\|[0-9a-f]{100,}$")) #"#")   ;; drop the trailing logits field
            steps (mapv (fn [p] (let [[ns _x id] (str/split p #"\|")] {:ms (/ (js/parseInt ns) 1e6) :id (.readUInt32LE (js/Buffer.from id "hex") 0)})) parts)
            generated (mapv :id (subvec steps (dec (count ids))))]   ;; the argmax after the last prompt token, then one per generated token
        {:generated (vec (take max-tokens generated)) :ms-per-token (/ (reduce + (map :ms steps)) (max 1 (count steps))) :wall-ms (- (js/Date.now) t0)}))))
(defn completion [body]
  (let [prompt (or (.-prompt body) "") max-tokens (or (.-max_tokens body) 16)
        ids (encode prompt)
        {:keys [generated error ms-per-token wall-ms]} (run-guest ids max-tokens)]
    (if error
      #js {:error #js {:message (str "guest trapped: " error) :type "server_error"}}
      #js {:id (str "cmpl-" (js/Date.now)) :object "text_completion" :created (quot (js/Date.now) 1000) :model "nex-n2.5-mini/kotoba-native"
           :choices #js [#js {:index 0 :text (decode generated) :finish_reason "length" :token_ids (clj->js generated)}]
           :usage #js {:prompt_tokens (count ids) :completion_tokens (count generated) :total_tokens (+ (count ids) (count generated))}
           :timing #js {:ms_per_token ms-per-token :wall_ms wall-ms}})))
(def server
  (http/createServer
   (fn [req res]
     (if (and (= "POST" (.-method req)) (= "/v1/completions" (.-url req)))
       (let [chunks (atom [])]
         (.on req "data" #(swap! chunks conj %))
         (.on req "end" (fn []
                          (let [body (try (js/JSON.parse (.toString (js/Buffer.concat (clj->js @chunks)) "utf8")) (catch :default _ nil))
                                out (if body (completion body) #js {:error #js {:message "bad json" :type "invalid_request_error"}})]
                            (.writeHead res (if (.-error out) 400 200) #js {"Content-Type" "application/json"})
                            (.end res (js/JSON.stringify out))))))
       (do (.writeHead res 404 #js {"Content-Type" "application/json"}) (.end res (js/JSON.stringify #js {:error "only POST /v1/completions"})))))))
(.listen server (js/parseInt port) (fn [] (println (str "SERVE\tnex kotoba-native\thttp://0.0.0.0:" port "/v1/completions\tguest " bin " @" offset))))
