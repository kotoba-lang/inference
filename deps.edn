{:paths ["cljc/src" "resources"]
 ;; real git pins (the old org.kotoba-lang/* group + :local/root pair was never
 ;; resolvable as a git dep — monorepo-layout-only). Workspace-offline dev
 ;; against sibling checkouts: use the :dev alias.
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}
        io.github.kotoba-lang/num {:git/sha "7bba3039e69cf47e5f75e82064fbca9213170a8e"}
        io.github.kotoba-lang/paillier
        {:git/sha "c6dad193ccdb306a02b6818ea34958c78e658570"}
        io.github.kotoba-lang/torch {:git/sha "ce636e29ba3551c51ce6e86beaf0c8a7e5b24dbd"}
        ;; Runtime side of the Kotoba decision cores (ADR-2608130700): execute
        ;; the precompiled KIR in resources/kotodama/oracle/. The COMPILER is
        ;; test-only (see :test) — a running server carries the interpreter,
        ;; not the toolchain.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "d58972da61758584a5bec0e863bcb3ea6fdd6c64"}}
 :aliases
 {:dev {:override-deps {io.github.kotoba-lang/num {:local/root "../num"}
                        io.github.kotoba-lang/paillier {:local/root "../paillier"}
                        io.github.kotoba-lang/torch {:local/root "../torch"}}}
  :test {:extra-paths ["cljc/test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; kotoba-lang/amu (formerly kotoba-lang/amu) is
                      ;; TEST-ONLY: it compiles kotoba/*_core.kotoba for the
                      ;; parity gate and for :gen. Same pin as murakumo's
                      ;; W6 oracle gate, so the two repos agree on what the
                      ;; language admits.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "e78241dca15000f6bb3976e97f493c70b0137dcf"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "cljc/test"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Regenerate resources/kotodama/oracle/*.kir.edn from kotoba/*_core.kotoba.
  ;; Carries no deps of its own; combine with :test, which carries the
  ;; compiler:  clojure -M:test:gen
  :gen {:main-opts ["-m" "kotodama.inference.kotoba-oracle-gen"]}
  :verify-shard {:extra-paths ["verify"]
                 :main-opts ["-m" "kotodama.verify.gemma4-e4b-shard"]}
  :verify-maturity {:extra-paths ["verify"]
                    :main-opts ["-m" "kotodama.verify.maturity"]}
  :verify-maturity-run {:extra-paths ["verify"]
                        :main-opts ["-m" "kotodama.verify.run-maturity"]}
  :verify-torch-num {:extra-paths ["verify"]
                     :main-opts ["-m" "kotodama.verify.torch-num-smoke"]}
  :verify-qwen4exp-mtp
  {:extra-paths ["verify"]
   :main-opts ["-m" "kotodama.verify.qwen4exp-mtp-checkpoint"]}
  :verify-qwen4exp-expert-stream
  {:extra-paths ["verify"]
   :main-opts ["-m" "kotodama.verify.qwen4exp-expert-stream-checkpoint"]}
  :verify-qwen4exp-mtp-b70-evidence
  {:extra-paths ["verify"]
   :main-opts ["-m" "kotodama.verify.qwen4exp-mtp-b70-evidence"]}
  :verify-qwen4exp-flash-next-b70-resident
  {:extra-paths ["verify"]
   :main-opts ["-m" "kotodama.verify.qwen4exp-flash-next-b70-resident"]}
  :verify-qwen4exp-b70-runtime-compatibility
  {:extra-paths ["verify"]
   :main-opts ["-m" "kotodama.verify.qwen4exp-b70-runtime-compatibility"]}
  :verify-encrypted-lm-head
  {:extra-paths ["verify"]
   :main-opts ["-m" "kotodama.verify.encrypted-lm-head"]}
  :cljs-wasm-smoke {:extra-paths ["verify"]
                    :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
                    :main-opts ["-m" "cljs.main"
                                "-co" "{:optimizations :simple :target :nodejs :main kotodama.verify.cljs-wasm-smoke :output-to \"target/kotodama-cljs-wasm-smoke.js\"}"
                                "-c" "kotodama.verify.cljs-wasm-smoke"]}
  :verify-gguf {:extra-paths ["verify"]
                :main-opts ["-m" "kotodama.verify.gemma4-e4b-gguf"]}
  :verify-gemma-num {:extra-paths ["verify"]
                     :main-opts ["-m" "kotodama.verify.gemma4-e4b-num-smoke"]}
  :verify-ollama {:extra-paths ["verify"]
                  :main-opts ["-m" "kotodama.verify.gemma4-e4b-ollama"]}
  :verify-gemma-generate {:extra-paths ["verify"]
                          :main-opts ["-m" "kotodama.verify.gemma4-e4b-generate-smoke"]}
  :verify-gemma-ple-generate {:extra-paths ["verify"]
                              ;; CACHE_WEIGHTS=1 materializes roughly 20 GiB of
                              ;; dequantized weights; the default JVM heap dies
                              ;; before the first real-model token.
                              :jvm-opts ["-Xmx24g" "--enable-native-access=ALL-UNNAMED"]
                              :main-opts ["-m" "kotodama.verify.gemma4-e4b-ple-generate-smoke"]}
  :verify-native-kdot {:extra-paths ["verify"]
                       :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                       :main-opts ["-m" "kotodama.verify.native-kdot"]}
  :verify-native-gemma-parity {:extra-paths ["verify"]
                               :jvm-opts ["-Xmx4g" "--enable-native-access=ALL-UNNAMED"]
                               :main-opts ["-m" "kotodama.verify.native-gemma4-parity"]}
  :verify-metal-kdot-worker {:extra-paths ["verify"]
                             :main-opts ["-m" "kotodama.verify.metal-kdot-worker"]}
  :serve-ollama {:main-opts ["-m" "kotodama.inference.host.ollama-server"]}
  :vllm-cli {:main-opts ["-m" "kotodama.inference.cli.vllm"]}
  :verify-gemma-kvcache {:extra-paths ["verify"]
                         :main-opts ["-m" "kotodama.verify.gemma4-kvcache-smoke"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "cljc/src" "cljc/test"
                     "--fail-level" "error"]}}}
